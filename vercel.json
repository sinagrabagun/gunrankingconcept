{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/img/:sku.webp",
      "destination": "/api/img?sku=:sku"
    },
    {
      "source": "/((?!assets/|img/|api/|icons/|social/|tools/|importer/|robots\\.txt|sitemap|llms\\.txt|favicon|grabagun-export|gunranking-export|social-export).*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; upgrade-insecure-requests" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=(), serial=(), hid=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    }
  ],
  "images": {
    "sizes": [
      320,
      640,
      1080
    ],
    "remotePatterns": [
      {
        "protocol": "https",
        "hostname": "upload.wikimedia.org"
      },
      {
        "protocol": "https",
        "hostname": "grabagun.com"
      },
      {
        "protocol": "https",
        "hostname": "ruger.com"
      },
      {
        "protocol": "https",
        "hostname": "www.sigsauer.com"
      },
      {
        "protocol": "https",
        "hostname": "cdn.shopify.com"
      },
      {
        "protocol": "https",
        "hostname": "danieldefense.com"
      },
      {
        "protocol": "https",
        "hostname": "springfieldarmory.b-cdn.net"
      },
      {
        "protocol": "https",
        "hostname": "eu-images.contentstack.com"
      },
      {
        "protocol": "https",
        "hostname": "www.mossberg.com"
      },
      {
        "protocol": "https",
        "hostname": "dam.beretta.com"
      },
      {
        "protocol": "https",
        "hostname": "www.benelliusa.com"
      },
      {
        "protocol": "https",
        "hostname": "www.bergara.online"
      },
      {
        "protocol": "https",
        "hostname": "silencerco.com"
      },
      {
        "protocol": "https",
        "hostname": "www.henryusa.com"
      }
    ],
    "formats": [
      "image/webp"
    ],
    "minimumCacheTTL": 86400,
    "localPatterns": [
      {
        "pathname": "/img/**"
      }
    ]
  },
  "functions": {
    "api/img.js": {
      "maxDuration": 30,
      "memory": 1024,
      "includeFiles": "api/_img-tokens.json"
    }
  }
}